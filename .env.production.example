# =============================================================
# Deda — production env template for the VPS.
# Copy this file to .env on the VPS and fill in real values.
# Never commit .env (it is in .gitignore).
# =============================================================

NODE_ENV=production

# -------- Database -------------------------------------------
POSTGRES_USER=deda
POSTGRES_PASSWORD=set-a-long-random-password-here
POSTGRES_DB=deda

# -------- Admin --------------------------------------------
# These two values are the only thing that lets someone into /admin.
# Pick a strong password; the api compares it in constant time.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-long-random-password-here

# Min 32 chars. Generate with:  openssl rand -hex 48
JWT_SECRET=replace-me-with-openssl-rand-hex-48-output
JWT_EXPIRES_IN=7d

# -------- URLs ----------------------------------------------
# Public origins. Used for canonical URLs, sitemap, OG images, etc.
NEXT_PUBLIC_SITE_URL=https://dedawomenswear.shop
# Empty in production: the storefront and api share an origin behind
# Nginx, so relative /api/* paths work.
NEXT_PUBLIC_API_URL=

# Origins the api accepts as CORS sources. Comma-separated, no spaces.
# Add the Cloudflare Pages URL once the storefront is live there too.
CORS_ORIGINS=https://dedawomenswear.shop,https://deda.pages.dev

# -------- Marketing pixels (optional) ------------------------
# Leave empty to skip injecting the pixel scripts entirely.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# -------- Backup -------------------------------------------
BACKUP_DIR=/opt/deda/backups
BACKUP_RETENTION_DAYS=60
