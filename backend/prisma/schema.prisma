generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Category {
  COLOURED
  BLACK
  SNAP
  EMBROIDERED
  OVERHEAD
  KIDS
  EVERYDAY
  READY
  WINTER
}

// Canonical color buckets used for the storefront colour filter.
// Specific variant colours (e.g. "Terracotta", "Sand") map onto one of these.
enum ColorGroup {
  WHITE
  BLACK
  GRAY
  BEIGE
  BROWN
  BLUE
  GREEN
  RED
  YELLOW
  PURPLE
  ORANGE
  MULTI
}

enum SaleStatus {
  IN_SALE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// LeadStatus and CouponType enums retired alongside the Lead and
// Coupon tables they typed. See the 20261101 migration.

// Deda is cash-on-delivery only — these enums stay narrow and leave
// space to grow later if a card gateway is ever added. PaymentStatus
// is nullable on COD orders (nothing captures until the courier does).
enum PaymentMethod {
  COD
}

enum PaymentStatus {
  CAPTURED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id            Int        @id @default(autoincrement())
  slug          String     @unique
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  basePrice     Int
  discount      Int?
  // Size-chart image URL — admin uploads one JPEG/PNG per product with
  // the measurements table. Shown as a modal on the product detail page.
  // Null hides the "size guide" link altogether.
  sizeChartUrl  String?
  category      Category
  status        SaleStatus @default(IN_SALE)
  isFeatured    Boolean    @default(false)
  isNew         Boolean    @default(false)
  isBestSeller  Boolean    @default(false)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  variants   Variant[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([category, status])
  @@index([isFeatured])
  @@index([isBestSeller])
  // Storefront default browse: status + sortOrder is the typical filter
  // pair (in-sale only, ordered by curator sort).
  @@index([status, sortOrder])
  // Storefront category browse with sort fallback to sortOrder.
  @@index([category, status, sortOrder])
  // Price-asc / price-desc sorting against the (small) in-sale subset.
  @@index([status, basePrice])
}

// A variant is one colour of a product. Sizes are stored as a string array
// (display only — no per-size stock counters by design).
model Variant {
  id          Int        @id @default(autoincrement())
  productId   Int
  colorNameEn String
  colorNameAr String
  colorHex    String
  colorGroup  ColorGroup
  sizes       String[]
  status      SaleStatus @default(IN_SALE)
  sortOrder   Int        @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]

  @@unique([productId, colorNameEn])
  @@index([colorGroup])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  variantId Int?
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, variantId])
}

// ---------------------------------------------------------------------------
// Storefront support tables
// ---------------------------------------------------------------------------

model Governorate {
  id          Int     @id @default(autoincrement())
  nameEn      String  @unique
  nameAr      String
  shippingFee Int
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

// Country / Coupon / Bundle / BundleProduct models retired — Deda ships
// Egypt-only (no Country table), doesn't run promo codes (no Coupon),
// and doesn't group products into deals (no Bundles). The 20261101
// migration drops the matching tables + CouponType enum from Postgres.

// ---------------------------------------------------------------------------
// Orders + leads
// ---------------------------------------------------------------------------

model Order {
  id              Int            @id @default(autoincrement())
  customerName    String
  phone1          String
  phone2          String?
  // ISO country code — "KW" for local Egypt orders, anything else for
  // international destinations seeded in the Country table.
  countryCode     String         @default("EG")
  // Only set when countryCode == "KW". Null for international orders.
  governorateName String?
  // Payment is cash-on-delivery across the board. paymentStatus goes
  // from null → CAPTURED when the courier confirms collection, and
  // → REFUNDED if the admin issues one back.
  paymentMethod   PaymentMethod  @default(COD)
  paymentStatus   PaymentStatus?
  address         String
  notes           String?
  subtotal        Int
  shippingFee     Int
  discount        Int         @default(0)
  total           Int
  couponCode      String?
  status          OrderStatus @default(PENDING)
  adminNotes      String?
  viewedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items   OrderItem[]

  @@index([status, createdAt])
  @@index([viewedAt])
  @@index([paymentStatus])
}

// Snapshot product names and prices at the time of order so historical
// orders stay readable even if products are renamed or repriced.
model OrderItem {
  id            Int    @id @default(autoincrement())
  orderId       Int
  productId     Int?
  productSlug   String
  productNameEn String
  productNameAr String
  colorNameEn   String
  colorNameAr   String
  colorHex      String
  size          String
  quantity      Int
  unitPrice     Int
  subtotal      Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// Lead / CategoryCardImage / HeroSlide models retired — Deda doesn't
// run a back-in-stock queue, doesn't surface a per-category grid, and
// uses a static hero. The 20261101 migration drops those tables.

// ---------------------------------------------------------------------------
// Site-wide settings — a single row keyed on id=1. Holds the social
// handles the storefront footer renders, plus anything else the admin
// wants to flip without a redeploy.
// ---------------------------------------------------------------------------
model SiteConfig {
  id                   Int      @id @default(1)
  whatsappNumber       String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  // Editorial split section on the homepage — admin-editable copy and
  // cover image. All nullable so a fresh install falls back to the
  // hardcoded defaults baked into the storefront.
  editorialEyebrowEn   String?
  editorialEyebrowAr   String?
  editorialHeadlineEn  String?
  editorialHeadlineAr  String?
  editorialBodyEn      String?
  editorialBodyAr      String?
  editorialImageUrl    String?
  // Hero slider — up to four admin-uploaded images that replace the
  // hardcoded FALLBACK_HERO_SLIDES on the homepage. Null slots fall
  // through to the fallback list in order.
  heroImage1Url        String?
  heroImage2Url        String?
  heroImage3Url        String?
  heroImage4Url        String?
  updatedAt            DateTime @updatedAt
}
