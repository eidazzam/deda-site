generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Category {
  COLOURED
  BLACK
  SNAP
  EMBROIDERED
  OVERHEAD
  KIDS
  EVERYDAY
  READY
  WINTER
}

// Canonical color buckets used for the storefront colour filter.
// Specific variant colours (e.g. "Terracotta", "Sand") map onto one of these.
enum ColorGroup {
  WHITE
  BLACK
  GRAY
  BEIGE
  BROWN
  BLUE
  GREEN
  RED
  YELLOW
  PURPLE
  ORANGE
  MULTI
}

enum SaleStatus {
  IN_SALE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  RESOLVED
}

enum CouponType {
  PERCENT
  FIXED
}

// Deda is cash-on-delivery only — these enums stay narrow and leave
// space to grow later if a card gateway is ever added. PaymentStatus
// is nullable on COD orders (nothing captures until the courier does).
enum PaymentMethod {
  COD
}

enum PaymentStatus {
  CAPTURED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id            Int        @id @default(autoincrement())
  slug          String     @unique
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  basePrice     Int
  discount      Int?
  category      Category
  status        SaleStatus @default(IN_SALE)
  isFeatured    Boolean    @default(false)
  isNew         Boolean    @default(false)
  isBestSeller  Boolean    @default(false)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  variants   Variant[]
  images     ProductImage[]
  bundleLink BundleProduct[]
  orderItems OrderItem[]
  leads      Lead[]

  @@index([category, status])
  @@index([isFeatured])
  @@index([isBestSeller])
  // Storefront default browse: status + sortOrder is the typical filter
  // pair (in-sale only, ordered by curator sort).
  @@index([status, sortOrder])
  // Storefront category browse with sort fallback to sortOrder.
  @@index([category, status, sortOrder])
  // Price-asc / price-desc sorting against the (small) in-sale subset.
  @@index([status, basePrice])
}

// A variant is one colour of a product. Sizes are stored as a string array
// (display only — no per-size stock counters by design).
model Variant {
  id          Int        @id @default(autoincrement())
  productId   Int
  colorNameEn String
  colorNameAr String
  colorHex    String
  colorGroup  ColorGroup
  sizes       String[]
  status      SaleStatus @default(IN_SALE)
  sortOrder   Int        @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]

  @@unique([productId, colorNameEn])
  @@index([colorGroup])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  variantId Int?
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, variantId])
}

// ---------------------------------------------------------------------------
// Storefront support tables
// ---------------------------------------------------------------------------

model Governorate {
  id          Int     @id @default(autoincrement())
  nameEn      String  @unique
  nameAr      String
  shippingFee Int
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

// International shipping destinations. Kuwait is NOT in this table —
// it's the implicit "local" path and uses the Governorate table for
// per-zone fees. Countries here are everywhere else we ship to.
model Country {
  id          Int     @id @default(autoincrement())
  code        String  @unique  // ISO 3166-1 alpha-2: EG, SA, AE...
  nameEn      String  @unique
  nameAr      String
  shippingFee Int     // piastres
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Coupon {
  code           String     @id
  type           CouponType
  value          Int
  minOrderAmount Int?
  maxDiscount    Int?
  expiresAt      DateTime?
  usageLimit     Int?
  usageCount     Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Bundle {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  bundlePrice   Int
  originalPrice Int
  imageUrl      String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products BundleProduct[]
}

model BundleProduct {
  bundleId  Int
  productId Int
  sortOrder Int @default(0)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
}

// ---------------------------------------------------------------------------
// Orders + leads
// ---------------------------------------------------------------------------

model Order {
  id              Int            @id @default(autoincrement())
  customerName    String
  phone1          String
  phone2          String?
  // ISO country code — "KW" for local Kuwait orders, anything else for
  // international destinations seeded in the Country table.
  countryCode     String         @default("KW")
  // Only set when countryCode == "KW". Null for international orders.
  governorateName String?
  // Payment is cash-on-delivery across the board. paymentStatus goes
  // from null → CAPTURED when the courier confirms collection, and
  // → REFUNDED if the admin issues one back.
  paymentMethod   PaymentMethod  @default(COD)
  paymentStatus   PaymentStatus?
  address         String
  notes           String?
  subtotal        Int
  shippingFee     Int
  discount        Int         @default(0)
  total           Int
  couponCode      String?
  status          OrderStatus @default(PENDING)
  adminNotes      String?
  viewedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items   OrderItem[]

  @@index([status, createdAt])
  @@index([viewedAt])
  @@index([paymentStatus])
}

// Snapshot product names and prices at the time of order so historical
// orders stay readable even if products are renamed or repriced.
model OrderItem {
  id            Int    @id @default(autoincrement())
  orderId       Int
  productId     Int?
  productSlug   String
  productNameEn String
  productNameAr String
  colorNameEn   String
  colorNameAr   String
  colorHex      String
  size          String
  quantity      Int
  unitPrice     Int
  subtotal      Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// Customers who left their info on out-of-stock products. Shown alongside
// orders in the admin so the owner can reach out manually when stock returns.
model Lead {
  id            Int        @id @default(autoincrement())
  name          String
  phone         String
  email         String
  productId     Int?
  productSlug   String
  productNameEn String
  productNameAr String
  colorName     String?
  size          String?
  status        LeadStatus @default(NEW)
  adminNotes    String?
  viewedAt      DateTime?
  createdAt     DateTime   @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}


// ---------------------------------------------------------------------------
// Homepage category cards — one row per Category enum value. The card
// names, slugs, and ordering all stay in the frontend (tied to the
// route map + i18n dictionary); the admin only flips the cover image.
// A missing row → frontend falls back to the hardcoded default image.
// ---------------------------------------------------------------------------
model CategoryCardImage {
  category  Category @id
  url       String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Homepage hero slider — admin-managed list of images that rotate at the
// top of the storefront. The slider component itself (interval, easing,
// dots) stays in the frontend; only the image set is editable.
// ---------------------------------------------------------------------------
model HeroSlide {
  id        Int      @id @default(autoincrement())
  url       String
  altEn     String?
  altAr     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Site-wide settings — a single row keyed on id=1. Holds the social
// handles the storefront footer renders, plus anything else the admin
// wants to flip without a redeploy.
// ---------------------------------------------------------------------------
model SiteConfig {
  id                   Int      @id @default(1)
  whatsappNumber       String?
  facebookUrl          String?
  instagramUrl         String?
  tiktokUrl            String?
  // Editorial split section on the homepage — admin-editable copy and
  // cover image. All nullable so a fresh install falls back to the
  // hardcoded defaults baked into the storefront.
  editorialEyebrowEn   String?
  editorialEyebrowAr   String?
  editorialHeadlineEn  String?
  editorialHeadlineAr  String?
  editorialBodyEn      String?
  editorialBodyAr      String?
  editorialImageUrl    String?
  updatedAt            DateTime @updatedAt
}
