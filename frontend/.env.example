# When the frontend talks to the api in local dev, point this at the
# Fastify backend on port 3001. In production via Docker the two are on
# the same Nginx-served origin and this can be left empty.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Used by sitemap + canonical URLs + OG tags. Update once the real domain
# is wired in.
NEXT_PUBLIC_SITE_URL=https://dedawomenswear.shop

# Marketing pixels — leave empty to disable the tag entirely.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
