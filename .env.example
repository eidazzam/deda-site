# =====================================================================
# Deda — Environment variables template
# Copy this file to .env and fill in real values before running anything.
# Never commit .env (it is in .gitignore).
# =====================================================================

# -------- Site --------
NODE_ENV=development
SITE_NAME=Deda
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------- Database --------
# Used by docker-compose to create the database
POSTGRES_USER=deda
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=deda

# Used by Prisma inside the api container (host = service name "postgres")
DATABASE_URL=postgresql://deda:change-me-strong-password@postgres:5432/deda?schema=public

# For local development outside Docker (host = localhost)
DATABASE_URL_LOCAL=postgresql://deda:change-me-strong-password@localhost:5432/deda?schema=public

# -------- API --------
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# -------- Admin auth --------
# Single-admin mode: one username + password, JWT signed with the secret below
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=generate-a-random-64-char-string-here
JWT_EXPIRES_IN=7d

# -------- Uploads --------
# Path inside the api container — the host folder is mounted here in docker-compose
UPLOAD_DIR=/app/uploads
# Public base URL Nginx serves the uploads from
NEXT_PUBLIC_UPLOAD_URL=/uploads

# -------- Marketing pixels (leave empty until you have real IDs) --------
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# -------- Tap Payments --------
# Get these from https://business.tap.company → Dashboard → Developers
#  • sk_test_xxx for the sandbox, sk_live_xxx for production.
#  • The webhook secret comes from the Webhooks tab and signs each callback.
# Leave empty to keep the stack running on COD only — the checkout will
# surface a "Tap not configured" error if a user picks online payment.
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=
TAP_BASE_URL=https://api.tap.company

# Public storefront URL Tap should redirect customers back to after
# payment. Must match the actual host the customer is browsing — locally
# it's http://localhost:3020, on the VPS it's https://dedawomenswear.shop.
PUBLIC_SITE_URL=http://localhost:3020

# Local-dev mock: when "true", checkout init skips Tap and sends the
# customer to /checkout/mock-tap where they can pick the outcome with a
# button. Leave empty / false in production.
TAP_MOCK_MODE=

# -------- Backup (production) --------
BACKUP_DIR=/opt/deda/backups
BACKUP_RETENTION_DAYS=60
